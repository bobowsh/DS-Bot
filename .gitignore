node_modules/
*.tgz
# The desktop app's window build (npm run build in app/), its packages (npm run pack, npm run dist)
# and the next version that checks its update (see app/README.md). The Office runtime payload
# (npm run runtime in app/) is downloaded per machine.
/app/ui/dist/
/app/dist-pack/
/app/dist-next/
/app/build/runtime/
/app/build/runtime-cache/
# The bundled skills repo is a repository of its own, made by scripts/skills-repo-git.mjs
# (scripts/before-pack.mjs runs it for every build). Its git dir is build output; the skills
# in it are the repository's own files.
/app/resources/skills-repo/.git/
# The data directory the installer ships: the plugins and the skills repository are made for
# every build (scripts/bundled-plugin.mjs, scripts/skills-repo-git.mjs), and the skills
# repository carries a git dir of its own.
/app/build/data/
# Some tests use a relative appDir ("app-dir"); its build output is test scratch, not source.
/app/app-dir/

# A DeepSeek Harness checkout for the tests and the test bench.
/deepseek-harness/

# Test bench, local DSH data and the screenshots of dev/check.sh.
.dsh-test*/
.dsh-home/
/shots/
.playwright-mcp/

# Extra patterns for scripts/scan.mjs that must not be named in the repository.
.scan-extra

# Persistent data for start.ps1 (profiles, credentials, chats and Bot files).
/.ds-bot-local/

# Browser-plugin bench output (the HTML report is written beside it and committed).
/browser-plugins/bench/out/

# Local Docker deployment data.
/docker/data/
/docker/workspace/
/docker/.env
/.env
/docker-compose.override.yml

# Bytecode from the record-browser-gif encoder's local media tests.
__pycache__/

# The scratch directory for this workspace's temporary scripts and output.
tmp/
app/tmp/
